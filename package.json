{
  "name": "kyminfo-textlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && vite --host 127.0.0.1 --port 5184 --strictPort",
    "build": "node scripts/generate.mjs && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4184 --strictPort",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": { "diff": "9.0.0" },
  "devDependencies": { "typescript": "7.0.2", "vite": "8.3.4" }
}
